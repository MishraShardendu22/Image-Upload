# ==============================================================================
# Image Upload & Asset Observatory - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MANDATORY AUTHENTICATION CREDENTIALS
# ------------------------------------------------------------------------------
# Only the credentials specified below are authorized to log in.
# No hardcoded fallbacks or default accounts (e.g. admin) will work.
AUTH_USERNAME=your_username_here
AUTH_PASSWORD=your_secure_password_here

# (Optional) Set to "true" to disable authentication entirely and make UI public
# DISABLE_AUTH=false

# ------------------------------------------------------------------------------
# 2. CLOUDINARY CDN CONFIGURATION (OPTIONAL / RECOMMENDED FOR PRODUCTION)
# ------------------------------------------------------------------------------
# If set, all uploads are permanently synced and served via Cloudinary CDN.
# If omitted, uploads and folder hierarchy are archived in local SQLite.

# Option A: Full Cloudinary URL
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Option B: Individual Cloudinary Credentials
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
